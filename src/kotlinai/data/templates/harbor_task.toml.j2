version = "1.0"
# Hand the agent's workspace to the separate verifier. tests/test.sh drops any
# prebuilt ./executable before it runs compile.sh, so the offline build still
# has to reproduce it (matching ProgramBench, whose evaluator wipes ./executable
# from the submission archive before compiling).
#
# Deliberately no `exclude`: Harbor only reaches for its tar-based transfer when
# an artifact has exclusions, and that path extracts host-side with
# `tarfile.extractall(filter="data")`, which raises AbsoluteLinkError on any
# absolute symlink in the tree. An agent aliasing the reference binary
# (`ln -s /workspace/executable /workspace/refbin`) therefore lost its whole
# workspace handoff and scored 0. With no exclusions Harbor uses `docker cp`,
# which is indifferent to symlinks.
artifacts = ["/workspace"]

[metadata]
author_name = "ProgramBench"
category = "{{ language }}"
tags = ["programbench", "reverse-engineering", "{{ language }}"]
instance_id = "{{ instance_id }}"
upstream_repository = "{{ repository }}"
upstream_commit = "{{ commit }}"
{% if difficulty %}difficulty_explanation = "{{ difficulty }}"
{% endif %}solution_explanation = "The reference source is intentionally removed; the agent must reverse-engineer the installed black-box binary and ship a compile.sh that rebuilds it offline."
verification_explanation = "A separate verifier container (built from the cleanroom image with /workspace wiped) receives the agent's /workspace as an artifact minus ./executable, rebuilds ./executable from compile.sh with no network, then runs each active test branch's behavioral suite against it. Reward is the fraction of non-ignored tests that pass."

# The environment baseline stays public so Harbor can build the image and install
# the agent CLI (agent setup runs before the agent-phase policy applies).
[environment]
build_timeout_sec = {{ build_timeout }}
cpus = {{ env_cpus }}
network_mode = "public"

# During inference, the agent can reach only the configured model, package,
# build-tool, and toolchain documentation hosts. Source hosting stays blocked:
# the agent must reverse-engineer the binary, not fetch upstream source.
# Overriding the baseline per phase requires a dynamic_network_policy
# environment backend (e.g. Docker/OrbStack on Linux with nftables).
#
# The agent runs as {{ agent_user }}. The default is a non-root user, so the
# mode-111 reference binary at /workspace/executable can be executed but not
# read, copied, or statically inspected; root would bypass those mode bits
# entirely and is only for oracle verification, whose golden solve.sh must read
# the reference (`harbor export --agent-user root`).
[agent]
timeout_sec = {{ agent_timeout }}
user = "{{ agent_user }}"
network_mode = "allowlist"
allowed_hosts = {{ allowed_hosts | tojson }}

# The verifier runs in its OWN container (not the agent-modified one),
# reproducing ProgramBench's fresh-container submission boundary. It keeps
# network (some test suites pip-install plugins or reach the network, and
# ProgramBench leaves test-execution containers online); test.sh blocks the
# network only around compile.sh so the build itself can't smuggle downloads.
[verifier]
timeout_sec = {{ verifier_timeout }}
environment_mode = "separate"
env = { PYTEST_ADDOPTS = "--max-worker-restart=4", PYTEST_XDIST_AUTO_NUM_WORKERS = "{{ verifier_cpus }}" }

[verifier.environment]
build_timeout_sec = {{ build_timeout }}
cpus = {{ verifier_cpus }}
network_mode = "public"
