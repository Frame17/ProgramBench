FROM {{ image_name }}:{{ image_tag }}
{% if install_kotlin %}
# compile.sh runs here with network blocked, so the JDK required by bundled
# Kotlin tooling and the compiler itself must be available in the verifier image.
RUN sed -i 's#https://snapshot.ubuntu.com/ubuntu/[0-9TZ]*/#http://archive.ubuntu.com/ubuntu/#g' /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl openjdk-21-jdk-headless unzip \
    && curl -fsSLo /tmp/kotlin-compiler.zip \
        "https://github.com/JetBrains/kotlin/releases/download/v{{ kotlin_version }}/kotlin-compiler-{{ kotlin_version }}.zip" \
    && echo "{{ kotlin_compiler_sha256 }}  /tmp/kotlin-compiler.zip" | sha256sum -c - \
    && unzip -q /tmp/kotlin-compiler.zip -d /opt \
    && rm -f /tmp/kotlin-compiler.zip \
    && rm -rf /var/lib/apt/lists/*
{% elif install_jdk %}
# Java submissions also rebuild offline in this image.
RUN sed -i 's#https://snapshot.ubuntu.com/ubuntu/[0-9TZ]*/#http://archive.ubuntu.com/ubuntu/#g' /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl openjdk-21-jdk-headless unzip \
    && rm -rf /var/lib/apt/lists/*
{% endif %}
{% if install_jdk %}
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
{% endif %}
{% if install_kotlin %}
ENV KOTLIN_HOME=/opt/kotlinc
ENV PATH="${KOTLIN_HOME}/bin:${PATH}"
{% endif %}
{% if install_gradle %}
# The offline compile.sh rebuild may invoke Gradle, so the verifier image must
# ship the same pinned Gradle and primed wrapper cache as the agent environment
# (offline parity). Fetch and verify the distribution here, at build time, where
# the verifier's [verifier.environment] baseline network is public.
RUN curl -fsSLo /tmp/gradle.zip \
        "https://services.gradle.org/distributions/gradle-{{ gradle_version }}-bin.zip" \
    && echo "{{ gradle_sha256 }}  /tmp/gradle.zip" | sha256sum -c - \
    && unzip -q /tmp/gradle.zip -d /opt \
    && rm -f /tmp/gradle.zip
ENV GRADLE_HOME=/opt/gradle-{{ gradle_version }}
ENV GRADLE_USER_HOME=/opt/gradle-home
ENV PATH="${GRADLE_HOME}/bin:${PATH}"
# Prime the wrapper distribution cache so a project's ./gradlew resolves the
# pinned distribution offline from GRADLE_USER_HOME during the compile step. Run
# with --no-daemon and drop any volatile daemon/tmp state afterwards (a stale
# baked daemon registry breaks a fresh run), then make the tree world-writable so
# the compile user reuses the primed cache and can write Gradle's runtime state.
RUN mkdir -p /tmp/gradle-seed \
    && cd /tmp/gradle-seed \
    && touch settings.gradle \
    && gradle wrapper --gradle-version {{ gradle_version }} --no-daemon \
    && ./gradlew --version --no-daemon \
    && cd / \
    && rm -rf /tmp/gradle-seed /opt/gradle-home/daemon /opt/gradle-home/.tmp \
    && chmod -R a+rwX /opt/gradle-home
{% endif %}
# The separate verifier must not inherit anything the agent left behind: wipe
# /workspace at build time. Harbor then restores only the handed-off artifacts
# (the agent's /workspace minus ./executable) on top before test.sh runs. Also
# wipe /opt/programbench/reference (where the environment image relocated the
# real reference binary) so the verifier image holds no recoverable copy either.
RUN rm -rf /workspace /opt/programbench/reference && mkdir -p /workspace
WORKDIR /workspace
# In separate-verifier mode Harbor does not upload the tests dir (the verifier
# runs with skip_tests_upload=True), so the image must own /tests: bake in
# test.sh, run_verifier.py, tests.json, clean_hashes.txt and the branch trees
# from the build context (which is this tests/ directory).
COPY . /tests
