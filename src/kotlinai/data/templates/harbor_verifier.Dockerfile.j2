FROM {{ image_name }}:{{ image_tag }}
# The separate verifier must not inherit anything the agent left behind: wipe
# /workspace at build time. Harbor then restores only the handed-off artifacts
# (the agent's /workspace minus ./executable) on top before test.sh runs.
RUN rm -rf /workspace && mkdir -p /workspace
WORKDIR /workspace
# In separate-verifier mode Harbor does not upload the tests dir (the verifier
# runs with skip_tests_upload=True), so the image must own /tests: bake in
# test.sh, run_verifier.py, tests.json, clean_hashes.txt and the branch trees
# from the build context (which is this tests/ directory).
COPY . /tests
