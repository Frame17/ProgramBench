#!/bin/bash
# Oracle solution for a ProgramBench reverse-engineering task.
#
# The black-box environment ships a working reference build at the canonical
# path the tests target — /workspace/executable — execute-only so a non-root
# agent cannot read its bytes. Portable tasks carry a compressed copy under
# /solution, a directory Harbor uploads only for its oracle agent. For older
# root-agent exports, the installed reference remains a fallback. The stash and
# compile.sh are handed off to the separate verifier as /workspace artifacts;
# compression changes the bytes' hash, so the stash survives the verifier's
# clean-hash scrub, and ./executable is decompressed only afterwards.
#
# (eval_clean_hashes is NOT the installed reference's hash — it is a gold-build
# hash from a different toolchain — so the reference cannot be located by it;
# the canonical /workspace/executable path is the reliable, language-agnostic
# source, matching conftest.py's EXECUTABLE = REPO_ROOT / "executable".)
set -euo pipefail

WORKSPACE=/workspace
REFERENCE="$WORKSPACE/executable"
PAYLOAD=/solution/reference.gz
STASH="$WORKSPACE/.programbench_oracle_reference.gz"

if [ -f "$PAYLOAD" ]; then
  if ! cp "$PAYLOAD" "$STASH"; then
    echo "FATAL: cannot copy the packaged oracle payload from $PAYLOAD" >&2
    exit 1
  fi
elif [ -x "$REFERENCE" ]; then
  if ! gzip -c "$REFERENCE" > "$STASH" 2>/dev/null; then
    echo "FATAL: cannot read the reference binary; re-export with --include-oracle-payload or use root" >&2
    exit 1
  fi
else
  echo "FATAL: no packaged oracle payload or reference binary available" >&2
  exit 1
fi

cp /solution/compile.sh "$WORKSPACE/compile.sh"
chmod +x "$WORKSPACE/compile.sh"
rm -f "$REFERENCE"
